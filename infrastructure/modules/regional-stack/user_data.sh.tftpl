#!/bin/bash
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io awscli jq
systemctl enable --now docker

REGION='${region}'
ENVIRONMENT='${environment}'
QUEUE_URL='${queue_url}'
SECRET_NAME='${db_secret_name}'
DOCKER_USER='${dockerhub_username}'
IMAGE_TAG='${image_tag}'

for attempt in $(seq 1 180); do
  SECRET_JSON=$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "$SECRET_NAME" --query SecretString --output text 2>/dev/null || true)
  [ -n "$SECRET_JSON" ] && [ "$SECRET_JSON" != "None" ] && break
  sleep 10
done

DB_HOST=$(echo "$SECRET_JSON" | jq -r .host)
DB_PORT=$(echo "$SECRET_JSON" | jq -r .port)
DB_NAME=$(echo "$SECRET_JSON" | jq -r .database)
DB_USER=$(echo "$SECRET_JSON" | jq -r .username)
DB_PASSWORD=$(echo "$SECRET_JSON" | jq -r .password)

for c in catalog-service order-service notification-service; do docker rm -f "$c" || true; done

docker pull "$DOCKER_USER/catalog-service:$IMAGE_TAG"
docker pull "$DOCKER_USER/order-service:$IMAGE_TAG"
docker pull "$DOCKER_USER/notification-service:$IMAGE_TAG"

docker run -d --name catalog-service --restart unless-stopped -p 8080:8080 \
  -e ENVIRONMENT="$ENVIRONMENT" -e AWS_REGION="$REGION" \
  -e DB_HOST="$DB_HOST" -e DB_PORT="$DB_PORT" -e DB_NAME="$DB_NAME" -e DB_USER="$DB_USER" -e DB_PASSWORD="$DB_PASSWORD" \
  "$DOCKER_USER/catalog-service:$IMAGE_TAG"

docker run -d --name order-service --restart unless-stopped -p 8081:8081 \
  -e ENVIRONMENT="$ENVIRONMENT" -e AWS_REGION="$REGION" -e QUEUE_URL="$QUEUE_URL" \
  -e DB_HOST="$DB_HOST" -e DB_PORT="$DB_PORT" -e DB_NAME="$DB_NAME" -e DB_USER="$DB_USER" -e DB_PASSWORD="$DB_PASSWORD" \
  "$DOCKER_USER/order-service:$IMAGE_TAG"

docker run -d --name notification-service --restart unless-stopped \
  -e PYTHONUNBUFFERED=1 -e ENVIRONMENT="$ENVIRONMENT" -e AWS_REGION="$REGION" -e QUEUE_URL="$QUEUE_URL" \
  "$DOCKER_USER/notification-service:$IMAGE_TAG"
